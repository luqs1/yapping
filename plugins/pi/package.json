{
  "name": "pi-yapping",
  "version": "0.1.0",
  "description": "yapping for pi: chat with your friends in a Discord-styled view inside pi, plus yap_inbox / yap_read / yap_send / yap_pending tools.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "chat", "yapping"],
  "license": "MIT",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": ["index.ts", "client.ts", "tools.ts", "view.ts", "vendor/", "README.md"],
  "scripts": {
    "prepack": "mkdir -p vendor && cp ../../shared/sim.js vendor/sim.js",
    "postpack": "rm -rf vendor",
    "check": "node test/render-check.mjs 160 46 >/dev/null"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
