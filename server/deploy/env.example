# /etc/yapping/env  (chmod 600, owned by root)
YAP_ORIGIN=https://yap.luqmaan.dev
PORT=8787
YAP_DATA=/var/lib/yapping

# Google sign-in (redirect URI: https://yap.luqmaan.dev/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in links via Resend
RESEND_API_KEY=
YAP_MAIL_FROM=yapping <hello@yap.luqmaan.dev>
